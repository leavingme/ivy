# Ivy environment variables
# Copy this file to .env.local for local dev, and set the same keys in
# Vercel Dashboard → Project → Settings → Environment Variables.

# Required: API key for the LLM used by /api/extract-char.
# DeepSeek (https://platform.deepseek.com/) or MiniMax (https://platform.minimax.cn/).
LLM_API_KEY=your-key-here

# Model — also selects the default base URL.
#   deepseek-flash  → https://api.deepseek.com                    (default)
#   MiniMax-M3      → https://api.minimaxi.com/v1
LLM_MODEL=deepseek-flash

# Optional overrides — usually unnecessary, the model name picks sane defaults.
# LLM_BASE_URL=https://api.deepseek.com
